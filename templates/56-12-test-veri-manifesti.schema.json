{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/azmisahin-gov/mihenk-arge/main/templates/56-12-test-veri-manifesti.schema.json",
  "title": "MİHENK 56.12 Kamuya Açık Test Veri Kümesi Manifesti",
  "description": "Yalnızca veri kümesi düzeyinde kaynak ve lisans metadata'sı içerir. Örnek bazlı ses, transkript, dosya yolu, hash ve kişi eşleştirme verileri bu manifestte tutulmaz.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset_id",
    "dataset_name",
    "dataset_version",
    "record_status",
    "source",
    "license_review",
    "purposes",
    "split_policy",
    "privacy",
    "records_summary",
    "limitations",
    "publication"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$"
    },
    "dataset_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "record_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "restricted",
        "retired"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "publisher",
        "source_url",
        "source_revision",
        "snapshot_date"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "public_dataset",
            "synthetic",
            "controlled_pilot"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "snapshot_date": {
          "type": "string",
          "format": "date"
        },
        "citation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "license_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "declared_license",
        "license_scope",
        "commercial_use",
        "redistribution",
        "attribution_required",
        "conditions",
        "evidence_urls",
        "reviewed_on"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved_for_evaluation",
            "restricted",
            "rejected"
          ]
        },
        "declared_license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "license_scope": {
          "type": "string",
          "enum": [
            "dataset_level",
            "per_item",
            "mixed_per_source",
            "unknown"
          ]
        },
        "commercial_use": {
          "type": "string",
          "enum": [
            "permitted",
            "prohibited",
            "conditional",
            "unknown",
            "not_assessed"
          ]
        },
        "redistribution": {
          "type": "string",
          "enum": [
            "permitted",
            "prohibited",
            "conditional",
            "unknown",
            "not_assessed"
          ]
        },
        "attribution_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "evidence_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "reviewed_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewer_role": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      }
    },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "asr_evaluation",
          "diarization_evaluation",
          "timestamp_evaluation",
          "vad_evaluation",
          "audio_processing_evaluation",
          "workflow_evaluation"
        ]
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "locked_test",
        "leakage_status",
        "split_names",
        "notes"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "source_predefined",
            "speaker_disjoint",
            "session_disjoint",
            "source_disjoint",
            "locked_external_test",
            "exploratory_only",
            "not_applicable"
          ]
        },
        "locked_test": {
          "type": "boolean"
        },
        "leakage_status": {
          "type": "string",
          "enum": [
            "pending",
            "checked",
            "partial",
            "unavailable"
          ]
        },
        "split_names": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_repo_contains_audio",
        "public_repo_contains_transcripts",
        "public_repo_contains_raw_paths",
        "public_repo_contains_per_sample_hashes",
        "identity_inference_performed",
        "contains_face_or_video_features",
        "storage_class",
        "retention_rule"
      ],
      "properties": {
        "public_repo_contains_audio": {
          "type": "boolean",
          "const": false
        },
        "public_repo_contains_transcripts": {
          "type": "boolean",
          "const": false
        },
        "public_repo_contains_raw_paths": {
          "type": "boolean",
          "const": false
        },
        "public_repo_contains_per_sample_hashes": {
          "type": "boolean",
          "const": false
        },
        "identity_inference_performed": {
          "type": "boolean",
          "const": false
        },
        "contains_face_or_video_features": {
          "type": "boolean"
        },
        "storage_class": {
          "type": "string",
          "enum": [
            "external_source_only",
            "restricted_local",
            "none"
          ]
        },
        "retention_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "records_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_records",
        "total_duration_seconds",
        "by_split"
      ],
      "properties": {
        "total_records": {
          "type": "integer",
          "minimum": 0
        },
        "total_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "by_split": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "split_name",
              "role",
              "record_count",
              "duration_seconds"
            ],
            "properties": {
              "split_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "role": {
                "type": "string",
                "enum": [
                  "train",
                  "validation",
                  "development",
                  "test",
                  "locked_test",
                  "evaluation_only",
                  "unknown"
                ]
              },
              "record_count": {
                "type": "integer",
                "minimum": 0
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1500
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_level_metadata_public",
        "sample_level_manifest_public"
      ],
      "properties": {
        "dataset_level_metadata_public": {
          "type": "boolean"
        },
        "sample_level_manifest_public": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
